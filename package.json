{
  "name": "dsh-vibe-mode",
  "description": "omp-style vibe mode for DeepSeek Harness: the session becomes a read-only director that drives persistent fast/good worker subagents",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-brand": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-subagent": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.3",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.3",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.3",
    "@deepseek-ai/dsh-subagent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
